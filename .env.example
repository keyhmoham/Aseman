# ==============================================================================
# Aseman AIOS - Root Docker Compose Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env in the project root to override default settings.
# All settings below are optional; sensible defaults are used if left blank.

# ── Node Identity & Configuration ─────────────────────────────────────────────
# Path to the node YAML config (identities, Google sign-in client, Modal credentials)
ASEMAN_CONFIG_FILE=./services/configs/config.yml

# Bootstrap admin password (handle is node.name defined in config.yml, e.g. "node-a")
ASEMAN_ADMIN_PASSWORD=changeme

# Public URL where peer nodes and web clients reach the Go API
ASEMAN_PUBLIC_URL=http://localhost:8080
ASEMAN_PORT=8080
WEB_PORT=3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_USER=aseman
POSTGRES_PASSWORD=aseman
POSTGRES_DB=aseman

# ── Transactional Email (Resend API) ──────────────────────────────────────────
# Used for sending 6-digit password reset verification codes.
# If left blank, codes are logged directly to the node console for development.
# Provide your Resend API key (https://resend.com/api-keys) and verified sender:
ASEMAN_RESEND_API_KEY=re_...
ASEMAN_SMTP_FROM=noreply@yourdomain.com

# Optional SMTP fallback (used only if ASEMAN_RESEND_API_KEY is not set):
# ASEMAN_SMTP_HOST=smtp.resend.com:587
# ASEMAN_SMTP_USER=resend
# ASEMAN_SMTP_PASSWORD=

# ── RevenueCat Backend In-App Purchases & Wallet Top-Ups ──────────────────────
# Secret v1 API Key from RevenueCat Dashboard (Project Settings -> API Keys -> Secret API Key).
# Required on the backend to verify client purchase receipts and top-up user wallets.
ASEMAN_REVENUECAT_SECRET=

# Optional: JSON map overriding credit allocations for top-up SKU products (amount in microcredits)
# Default packs: aseman_topup_20 -> 20M, aseman_topup_50 -> 50M, aseman_topup_100 -> 100M
# ASEMAN_REVENUECAT_PRODUCTS={"aseman_topup_20":20000000,"aseman_topup_50":50000000,"aseman_topup_100":100000000}
# To show what a buyer actually paid (after a discount, on any store), set the
# RevenueCat project id; the node then reads each purchase's revenue from
# RevenueCat's v2 API. A v2 secret key is needed if the key above is a v1 key.
# ASEMAN_REVENUECAT_PROJECT=
# ASEMAN_REVENUECAT_V2_SECRET=

# ── Sign in with Google & Apple ───────────────────────────────────────────────
# Google OAuth Client IDs (Google Cloud Console -> APIs & Credentials):
# The backend validates provider identity tokens against this client id.
ASEMAN_GOOGLE_CLIENT_ID=

# Sign in with Apple: comma-separated accepted audiences. The iOS app signs in with its
# bundle ID, so that is the value to set (com.aseman.app). Left empty, the node reports
# Apple sign-in as off and the iOS app hides the button. Needs `docker compose up -d` to apply.
ASEMAN_APPLE_CLIENT_ID=com.aseman.app

# iOS push notifications (invitations, messages and agent replies in a project).
# Create an "Apple Push Notifications service (APNs)" key at developer.apple.com → Certificates,
# Identifiers & Profiles → Keys. It downloads once, as AuthKey_<KEY ID>.p8.
#   ASEMAN_APNS_KEY      the key on one line:  base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
#                           (the key's text, or a path the node can read, also work)
#   ASEMAN_APNS_KEY_ID   the 10-character Key ID shown beside the key
#   ASEMAN_APNS_TEAM_ID  your Team ID (developer.apple.com → Membership)
#   ASEMAN_APNS_TOPIC    the app's bundle ID; left empty, the first ASEMAN_APPLE_CLIENT_ID is used
# Left empty, no notifications are sent and everything else works. Needs `docker compose up -d` to apply.
ASEMAN_APNS_KEY=
ASEMAN_APNS_KEY_ID=
ASEMAN_APNS_TEAM_ID=
ASEMAN_APNS_TOPIC=

# ── Sandboxes & Orchestrator ──────────────────────────────────────────────────
# Sandbox backend: "docker" (local per-space container) or "modal" (remote Modal sandbox)
ASEMAN_SANDBOX_BACKEND=docker
# Modal sandboxes: set the backend to "modal", add your Modal API token, and point
# ASEMAN_SANDBOX_IMAGE at a PUBLIC registry image (Modal cannot pull the
# locally built aseman/sandbox-computer:latest). Build and push it with:
#   docker build -t YOURUSER/aseman-sandbox:latest deploy/sandbox-computer && docker push YOURUSER/aseman-sandbox:latest
# ASEMAN_MODAL_TOKEN_ID=ak-...
# ASEMAN_MODAL_TOKEN_SECRET=as-...
# Modal environment for this node's sandboxes, workspace volumes and costs. Create it
# first (`modal environment create dev`); leave unset to use the default environment.
# Use a different one for local and prod so their sandboxes never mix.
# ASEMAN_MODAL_ENVIRONMENT=dev
ASEMAN_SANDBOX_DOCKER_NETWORK=aseman_default
ASEMAN_SANDBOX_IMAGE=aseman/sandbox-computer:latest

# Nomad allocation directory and version
NOMAD_DATA_DIR=/tmp/aseman-nomad
NOMAD_VERSION=1.10

# ── Deep Agents Runtime ───────────────────────────────────────────────────────
# Agent runtime image run by Nomad when an agent performs work
ASEMAN_AGENT_RUNTIME_IMAGE=aseman/deepagents:v2
ASEMAN_AGENT_NODE_URL=http://aseman:8080
ASEMAN_AGENT_RUNTIME_NETWORK=aseman_default
# Memory (MB) the agent runtime reserves on Nomad. If agents answer "did not become healthy" on a small
# server, Nomad could not find this much free memory: lower it (min 256). Default 2048.
# ASEMAN_AGENT_RUNTIME_MEMORY_MB=2048
# Optional: run the runtime manually and point the node to it:
# ASEMAN_AGENT_RUNTIME_URL=http://localhost:8000
# Provider liveness limits. The total call may be long, but a stream must begin
# and keep producing events; use Go duration strings.
# ASEMAN_LLM_CALL_TIMEOUT=5m
# ASEMAN_LLM_FIRST_EVENT_TIMEOUT=2m
# ASEMAN_LLM_STREAM_IDLE_TIMEOUT=45s
# Swarm tasks the lead runs at once (run_swarm). Default 8.
# ASEMAN_SWARM_PARALLEL=8
# Agents improving their own playbook with GEPA, billed to the project like
# memory: 0 turns it off. A cycle runs after a poor turn or every N turns, at
# most once per COOLDOWN seconds per agent and project, replaying at most
# BUDGET steps.
# ASEMAN_IMPROVE=1
# ASEMAN_IMPROVE_EVERY=10
# ASEMAN_IMPROVE_COOLDOWN=10800
# ASEMAN_IMPROVE_BUDGET=60

# ── Agent Memory (self-hosted OpenViking, deploy/openviking) ──────────────────
# The agents' long-term memory lives in an OpenViking server this stack runs
# (service "openviking", data in the openviking-data volume). The runtime and
# the node reach it with this root key; ./aseman.sh up and the deploy
# workflows generate one into .env when it is missing. Keep it secret: it
# opens every project's memory.
# ASEMAN_OPENVIKING_ROOT_KEY=<64 random hex characters>
#
# Its models need no settings here: pick them in Admin -> Memory models, from
# the providers and models set up under Admin -> Providers / Models.
#
# How much memory is recalled with each message (tokens; 0 turns recall off):
# ASEMAN_OPENVIKING_RECALL_TOKENS=1500
# Optional: an OpenViking server of your own instead of the stack's:
# ASEMAN_OPENVIKING_URL=http://openviking:1933

# ── Project Timeline (self-hosted Utopia, on the stack's Postgres) ────────────
# Every project's dated timeline of work and events, read by every agent as a
# built-in MCP server. Utopia (service "timeline") keeps it in its own database
# (aseman_timeline) on the stack's Postgres. The node signs in to it with
# this password; ./aseman.sh up and the deploy workflows generate one into
# .env when it is missing. Keep it secret.
# ASEMAN_TIMELINE_PASSWORD=<64 random hex characters>
#
# Set to an empty value to turn the timelines off:
# ASEMAN_TIMELINE_URL=
# Optional: the database name, Utopia's image, and its share of Postgres connections.
# ASEMAN_TIMELINE_DB=aseman_timeline
# ASEMAN_TIMELINE_IMAGE=ghcr.io/deeplethe/utopia:0.1.0-rc9
# ASEMAN_TIMELINE_DB_CONNECTIONS=16

# ── LLM Initial Bootstrapping (Optional) ──────────────────────────────────────
# Seed the initial LLM provider (OpenAI) on first boot. Providers, models, and token
# prices can subsequently be edited in Admin Console -> LLM.
ASEMAN_LLM_API_KEY=
ASEMAN_LLM_BASE_URL=
ASEMAN_LLM_MODEL=gpt-5.4

# Optional: Pin the aseman planning orchestrator to a specific provider and model
ASEMAN_ORCHESTRATOR_PROVIDER=
ASEMAN_ORCHESTRATOR_MODEL=

# Allow user-supplied MCP tools on private local network addresses
ASEMAN_MCP_ALLOW_PRIVATE=false

# ── Production (deploy/docker-compose.prod.yml + deploy/caddy/Caddyfile) ───────
# Domains Caddy serves with automatic HTTPS (both must point at the server):
# APP_DOMAIN=app.example.com
# API_DOMAIN=connect.example.com
# ACME_EMAIL=you@example.com
# The developer API on its own host. The node serves only that API on it, with
# API keys. Empty: the developer API is off.
# DEVELOPER_DOMAIN=api.example.com
# Where the node keeps files (chat attachments and developer API Storage), instead of its
# own disk: an S3-compatible bucket. For Cloudflare R2 create a bucket and an API token
# with Object Read & Write, then:
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=aseman-files
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto
# Files already on the node's disk are not moved: copy ./data/files into the bucket first
# (same keys), e.g. with rclone, before switching a node that has data.
# …and tell clients where the node is:
# ASEMAN_PUBLIC_URL=https://api.example.com

# ── Governance, connections and proactive work ───────────────────────────────
# Refuse every agent action while the governance namespace is not loaded.
# ASEMAN_GOVERNANCE_REQUIRED=1
# How long an action (or a secret box) waits on a person: 30m by default.
# ASEMAN_APPROVAL_TIMEOUT=30m
# Also record plain allowed reads in the audit trail (many rows).
# ASEMAN_AUDIT_READS=1
# Project computers' network: the proxy image (empty: no proxy), the default
# mode of a project that has not chosen one, and hosts always reachable.
# ASEMAN_EGRESS_IMAGE=aseman/egress-proxy:v1
# ASEMAN_EGRESS_DEFAULT_MODE=allow_all
# ASEMAN_EGRESS_ALWAYS=
# Run project computers under gVisor where the host has it.
# ASEMAN_SANDBOX_RUNTIME=runsc
# Where people land after connecting an account (the web client).
# ASEMAN_APP_URL=http://localhost:3000
# The test Google (go run ./cmd/fakegoogle); ignored when ASEMAN_ENV=production.
# ASEMAN_FAKE_GOOGLE_URL=http://127.0.0.1:4900
