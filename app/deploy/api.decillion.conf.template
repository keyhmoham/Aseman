# A Decillion node as the app's API, still on the app's own origin, so the
# app runs as it does beside its own node: same-origin calls, project pages
# in frames, desktop and dev-server websockets.
# Rendered at start by deploy/render-api-conf.sh (default
# https://preview.decillionai.com, or DECILLION_API_URL) on Render, `docker
# run`, or `./aseman.sh up`.
# Placeholders: DECILLION_API_URL, DECILLION_API_HOST, DECILLION_API_RESOLVER.
location ~ ^/(v1|fed|healthz) {
    # Resolved when a request arrives, so a node behind a CDN is followed and
    # nginx starts without it. Public resolvers work on Render; Docker's
    # 127.0.0.11 does not.
    resolver ${DECILLION_API_RESOLVER} ipv6=off valid=30s;
    set $decillion_api ${DECILLION_API_URL};
    proxy_pass $decillion_api;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name ${DECILLION_API_HOST};
    proxy_set_header Host ${DECILLION_API_HOST};
    # The node is addressed as itself: a desktop or tunnel socket's Origin is
    # checked against the node's host (the browser's is this page's), and the
    # address a person reaches the node at is the node's own.
    proxy_set_header Origin ${DECILLION_API_URL};
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Links and cookies the node hands back point at this origin.
    proxy_redirect ${DECILLION_API_URL}/ /;
    proxy_cookie_domain ${DECILLION_API_HOST} $host;
    proxy_read_timeout 600s;   # agent turns and image generation can be slow
    proxy_send_timeout 600s;
    proxy_buffering off;
}
