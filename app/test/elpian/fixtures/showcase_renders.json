{
 "board": {
  "type": "Scaffold",
  "children": [
   {
    "type": "ListView",
    "children": [
     {
      "type": "Column",
      "props": {
       "style": {
        "padding": "16",
        "gap": "24"
       }
      },
      "children": [
       {
        "type": "Row",
        "props": {
         "style": {
          "gap": "12",
          "alignItems": "center"
         }
        },
        "children": [
         {
          "type": "Expanded",
          "children": [
           {
            "type": "Column",
            "props": {
             "style": {
              "gap": "4"
             }
            },
            "children": [
             {
              "type": "Text",
              "props": {
               "text": "Team tasks",
               "variant": "headlineMediumEmphasized"
              }
             },
             {
              "type": "Text",
              "props": {
               "text": "1 open · 50% done",
               "variant": "bodyMedium",
               "color": "muted"
              }
             }
            ]
           }
          ]
         },
         {
          "type": "IconButton",
          "props": {
           "icon": "refresh",
           "variant": "tonal",
           "tooltip": "Refresh"
          },
          "events": {
           "tap": "__app0_reload"
          }
         }
        ]
       },
       {
        "type": "Column",
        "props": {
         "style": {
          "gap": "16"
         }
        },
        "children": [
         {
          "type": "Card",
          "props": {
           "tone": "primary",
           "style": {
            "padding": "20",
            "gap": "12"
           }
          },
          "children": [
           {
            "type": "Stat",
            "props": {
             "label": "Sprint progress",
             "value": 0.5,
             "format": "percent",
             "icon": "rocket_launch",
             "size": "hero"
            }
           },
           {
            "type": "Progress",
            "props": {
             "value": 0.5,
             "showValue": false,
             "wavy": true
            }
           }
          ]
         },
         {
          "type": "SegmentedButton",
          "key": "filter",
          "props": {
           "selected": "open",
           "segments": [
            {
             "value": "open",
             "label": "Open",
             "icon": "inbox"
            },
            {
             "value": "done",
             "label": "Done",
             "icon": "task_alt"
            },
            {
             "value": "all",
             "label": "All"
            }
           ]
          },
          "events": {
           "change": "__app0_filter"
          }
         },
         {
          "type": "AnimatedSwitcher",
          "children": [
           {
            "type": "ListGroup",
            "key": "list_open",
            "children": [
             {
              "type": "ListTile",
              "key": "task_1",
              "props": {
               "title": "Ship the release",
               "subtitle": "Ann · due today",
               "leading": "priority_high",
               "trailingText": "Urgent"
              },
              "events": {
               "tap": "__app0_toggle_1"
              }
             }
            ]
           }
          ]
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "type": "NavigationBar",
    "props": {
     "selected": 0,
     "items": [
      {
       "icon": "checklist",
       "label": "Tasks",
       "badge": 1
      },
      {
       "icon": "add_task",
       "label": "New"
      },
      {
       "icon": "insights",
       "label": "Insights"
      }
     ]
    },
    "events": {
     "change": "__app0_tab"
    }
   }
  ]
 },
