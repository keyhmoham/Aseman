# The public edge: one block per domain. Caddy gets and renews the HTTPS
# certificates itself (the domains must point at this server).
#
# The values come from the root .env:
#   APP_DOMAIN   the web app          (e.g. app.example.com)
#   API_DOMAIN   the node's API       (e.g. connect.example.com)
#   DEVELOPER_DOMAIN  the developer API (e.g. api.example.com); optional
#   ACME_EMAIL   certificate contact

{
	email {$ACME_EMAIL}
}

# Web app. It already proxies /v1 to the node on its own origin, so the app works
# with this block alone.
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80 {
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

# The node's API on its own domain: native apps, other nodes and webhooks.
{$API_DOMAIN} {
	request_body {
		max_size 90MB
	}
	# A project preview opened here that navigates to a root path
	# (location.href = "/about") goes back into its own proxy.
	@fromPreview {
		not path /v1/*
		header_regexp preview Referer ^https?://[^/]+(/v1/proxy/[0-9a-fA-F]+)/
	}
	redir @fromPreview {re.preview.1}{uri} 307
	reverse_proxy tradera:8080 {
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

# The developer API: its own host, for people calling the platform from their own
# code with an API key. The node serves only that API here (TRADERA_DEVELOPER_HOST
# is the same name), never the app's own actions. Responses are streamed.
{$DEVELOPER_DOMAIN:developer.localhost} {
	request_body {
		max_size 64MB
	}
	reverse_proxy tradera:8080 {
		flush_interval -1
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

# www.<APP_DOMAIN> sends people to the app's own address, keeping the path and
# query. Caddy gets this name its own certificate, so the www address must point
# at this server (an A record, or a CNAME to the app domain) before it is used.
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# Add more domains the same way, e.g. a marketing site.
