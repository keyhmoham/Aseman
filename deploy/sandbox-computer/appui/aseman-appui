#!/usr/bin/env bash
# Aseman App UI helper: drive OpenCode in the space sandbox against Aseman's
# metered LLM gateway (same backbone agents use). Writes READY.json after tests.
set -euo pipefail

ROOT="${ASEMAN_APPUI_ROOT:-/opt/aseman-appui}"
OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode || true)}"
CONFIG_DIR="${OPENCODE_CONFIG_DIR:-/etc/opencode}"
export OPENCODE_CONFIG="${OPENCODE_CONFIG:-$CONFIG_DIR/opencode.json}"

# Credentials / base URL from ensureOpenCodeAuth (turn-scoped). Must load
# before reading OPENCODE_MODEL — CreateBot may still inject a stale "free".
# shellcheck disable=SC1091
[[ -f /etc/opencode/env.sh ]] && . /etc/opencode/env.sh
# Prefer Aseman backbone; never keep the Zen "free" alias.
MODEL_FLAG="${OPENCODE_MODEL:-aseman/default}"
if [[ "$MODEL_FLAG" == "free" || "$MODEL_FLAG" == opencode/* ]]; then
  MODEL_FLAG="aseman/default"
fi
unset OPENCODE_API_KEY 2>/dev/null || true

die() { echo "aseman-appui: $*" >&2; exit 1; }

need_opencode() {
  [[ -n "$OPENCODE_BIN" && -x "$OPENCODE_BIN" ]] || die "opencode is not installed in this sandbox image"
}

need_llm() {
  [[ -n "${ASEMAN_LLM_API_KEY:-}" && -n "${ASEMAN_LLM_BASE_URL:-}" ]] || \
    die "Aseman LLM gateway not configured (ASEMAN_LLM_BASE_URL / ASEMAN_LLM_API_KEY). Run via appui_create during an agent turn."
}

write_file() {
  local path="$1"
  local dir
  dir=$(dirname "$path")
  mkdir -p "$dir"
  cat >"$path"
}

same_file() {
  local a b
  a=$(readlink -f "$1" 2>/dev/null || echo "$1")
  b=$(readlink -f "$2" 2>/dev/null || echo "$2")
  [[ "$a" == "$b" ]]
}

cmd_models() {
  need_opencode
  echo "backbone: aseman metered LLM gateway"
  echo "base_url: ${ASEMAN_LLM_BASE_URL:-unset}"
  echo "api_key: ${ASEMAN_LLM_API_KEY:+set}"
  echo "model: ${MODEL_FLAG}"
  "$OPENCODE_BIN" models 2>/dev/null || true
}

cmd_status() {
  local dir="${1:-.}"
  dir=$(cd "$dir" && pwd)
  if [[ -f "$dir/READY.json" ]]; then
    echo "state: ready"
    cat "$dir/READY.json"
    return 0
  fi
  if [[ -f "$dir/STATUS.json" ]]; then
    echo "state: $(jq -r .state "$dir/STATUS.json" 2>/dev/null || echo running)"
    cat "$dir/STATUS.json"
    return 0
  fi
  echo "state: idle"
  echo '{"state":"idle"}'
}

run_opencode() {
  local dir="$1"
  shift
  local message="$*"
  need_opencode
  need_llm
  mkdir -p "$dir"
  local logfile="$dir/opencode.log"
  local statusfile="$dir/STATUS.json"
  local model="${MODEL_FLAG}"
  # Bound the coding session; platform owns the outer appui build deadline.
  local secs="${OPENCODE_RUN_TIMEOUT_SECS:-600}"
  write_file "$statusfile" <<EOF
{"state":"running","model":"$model","backbone":"aseman","started_at":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
EOF
  echo "aseman-appui: opencode run model=$model base=${ASEMAN_LLM_BASE_URL} timeout=${secs}s" | tee -a "$logfile"
  set +e
  (
    cd "$dir"
    timeout -k 15s "${secs}s" "$OPENCODE_BIN" run --auto --model "$model" --format default --title "aseman-appui" -- "$message"
  ) >>"$logfile" 2>&1
  local ec=$?
  set -e
  if [[ $ec -eq 0 ]]; then
    write_file "$statusfile" <<EOF
{"state":"completed","model":"$model","backbone":"aseman","finished_at":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
EOF
    return 0
  fi
  write_file "$statusfile" <<EOF
{"state":"failed","model":"$model","backbone":"aseman","finished_at":"$(date -u +%Y-%m-%dT%H:%M:%SZ)","error":"opencode failed (exit $ec); see opencode.log"}
EOF
  echo "aseman-appui: opencode failed (exit $ec); see $logfile" >&2
  return 1
}

cmd_run() {
  local dir="."
  local message=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --message) message="$2"; shift 2 ;;
      -*) die "unknown flag $1" ;;
      *) message="${message:+$message }$1"; shift ;;
    esac
  done
  [[ -n "$message" ]] || die "run needs a message"
  dir=$(mkdir -p "$dir" && cd "$dir" && pwd)
  run_opencode "$dir" "$message"
  cmd_status "$dir"
}

# verify_app starts READY.json's `start` command the way the preview gateway
# will, waits for the port to answer and stops it again. Prints why it failed.
verify_app() {
  local dir="$1"
  local start port pid code
  start=$(jq -r '.start // empty' "$dir/READY.json" 2>/dev/null || true)
  port=$(jq -r '.port // empty' "$dir/READY.json" 2>/dev/null || true)
  if [[ -z "$start" || -z "$port" ]]; then
    echo "READY.json has no start command or port"
    return 1
  fi
  local ui entry elpian_problem=""
  ui=$(jq -r '.ui // "web"' "$dir/READY.json" 2>/dev/null || echo web)
  entry=$(jq -r '.elpian // "elpian/app.js"' "$dir/READY.json" 2>/dev/null || echo elpian/app.js)
  if [[ "$ui" == "elpian" ]]; then
    # The bundle is always rebuilt from elpian/src: what is checked and
    # served is the current frontend.
    if ! out=$(node "$dir/vendor/aseman-elpian/bundle.mjs" "$dir" 2>&1); then
      echo "the Elpian frontend could not be bundled: $out"
      return 1
    fi
  fi
  # A previous version may still serve the port: the new build is what is
  # checked and then served.
  fuser -k "$port/tcp" >/dev/null 2>&1 || true
  (cd "$dir" && PORT="$port" HOST=0.0.0.0 exec setsid bash -c "$start") >"$dir/verify.log" 2>&1 &
  pid=$!
  code=000
  for _ in $(seq 1 "${ASEMAN_APPUI_VERIFY_SECS:-60}"); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$port/" 2>/dev/null || true)
    [[ -n "$code" && "$code" != "000" ]] && break
    code=000
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if [[ "$ui" == "elpian" && "$code" != "000" ]] && (( code < 500 )); then
    elpian_problem=$(check_elpian "$dir" "$port" "$entry") || true
  fi
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fuser -k "$port/tcp" >/dev/null 2>&1 || true
  wait "$pid" 2>/dev/null || true
  if [[ "$code" == "000" ]]; then
    echo "\`$start\` did not answer on 0.0.0.0:$port. Its output:"
    tail -n 40 "$dir/verify.log" 2>/dev/null
    return 1
  fi
  if (( code >= 500 )); then
    echo "GET / on port $port answered HTTP $code. Server output:"
    tail -n 40 "$dir/verify.log" 2>/dev/null
    return 1
  fi
  if [[ -n "$elpian_problem" ]]; then
    echo "$elpian_problem"
    return 1
  fi
  return 0
}

# check_elpian checks an Elpian frontend against the running server: the
# server serves the bundle, and the program runs on QuickJS (check.mjs).
check_elpian() {
  local dir="$1" port="$2" entry="$3" code out
  code=$(curl -s -o "$dir/.elpian-served.js" -w '%{http_code}' --max-time 5 "http://127.0.0.1:$port/$entry" 2>/dev/null || echo 000)
  if [[ "$code" != "200" ]]; then
    echo "GET /$entry answered HTTP $code: the server must serve the Elpian bundle at that path (ELPIAN.md)."
    return 1
  fi
  if ! cmp -s "$dir/.elpian-served.js" "$dir/$entry"; then
    echo "GET /$entry does not serve the current bundle $entry (it must serve the file itself, read on each request)."
    return 1
  fi
  rm -f "$dir/.elpian-served.js"
  if ! out=$(node "$dir/vendor/aseman-elpian/check.mjs" "$dir/$entry" --apps "$dir/APPS.json" --server "http://127.0.0.1:$port" 2>&1); then
    echo "The Elpian frontend fails on QuickJS (vendor/aseman-elpian/check.mjs):"
    echo "$out" | tail -n 40
    return 1
  fi
  return 0
}

# check_ready prints why READY.json is not acceptable (nothing when it is).
check_ready() {
  local dir="$1"
  if [[ ! -f "$dir/READY.json" ]]; then
    echo "READY.json was not written (tests not run, or failing?)"
    return 1
  fi
  if jq -e '.ok == false' "$dir/READY.json" >/dev/null 2>&1; then
    echo "READY.json reports a failure: $(jq -r '.error // "unknown"' "$dir/READY.json")"
    return 1
  fi
  if ! jq -e '.ok == true and .tested == true and (.start|type=="string" and length>0) and (.port|type=="number")' \
    "$dir/READY.json" >/dev/null 2>&1; then
    echo "READY.json is incomplete (needs ok, tested, start, port)"
    return 1
  fi
  local want
  want=$(jq -r '.ui // "elpian"' "$dir/JOB.json" 2>/dev/null || echo elpian)
  if [[ "$want" == "elpian" ]] && ! jq -e '.ui == "elpian" and (.elpian|type=="string" and length>0)' "$dir/READY.json" >/dev/null 2>&1; then
    echo "this app's frontend is Elpian (JOB.json ui): READY.json needs \"ui\": \"elpian\" and \"elpian\": \"elpian/app.js\" (see ELPIAN.md)"
    return 1
  fi
}

build_prompt() {
  local dir="$1" port="$2" mode="$3" ui="${4:-elpian}" task frontend
  if [[ "$mode" == "update" ]]; then
    task="This is an existing app (BRIEF.md is what it was built for). Make the change requested last in CHANGES.md and keep everything else working. Read the project before editing; change only what the request needs."
  else
    task="Build a new app for BRIEF.md in this directory."
  fi
  if [[ "$ui" == "elpian" ]]; then
    frontend=$(cat <<FRONT
The frontend is an ELPIAN program (JOB.json ui: elpian), not a web page:
JavaScript on the Elpian QuickJS runtime inside the Aseman client, drawing
native UI from JSON view trees. Read ELPIAN.md in full first and study
vendor/aseman-elpian/ (aseman-elpian.js SDK, openui-elpian.js, nodes.json).
Write it in elpian/src/*.js with App.create + Aseman.* (no DOM, no fetch, no
modules); use the UI kit nodes for data views; mix OpenUI agent islands
(OpenUI.panel / action / query) with programmed UI where judgment helps.
Your server serves GET /elpian/app.js (the bundle) and its API. Bundle with
node vendor/aseman-elpian/bundle.mjs . and check with
node vendor/aseman-elpian/check.mjs elpian/app.js --apps APPS.json --server http://127.0.0.1:$port
(with the server running) until it passes. AGENTS.md's web rules (M3E,
web theming, the web OpenUI kit) do not apply.
FRONT
)
  else
    frontend=$(cat <<FRONT
The frontend is WEB (JOB.json ui: web), because the person asked for web
technology: follow AGENTS.md's web rules (Material 3 Expressive via
@material/web unless the brief names another framework, Aseman adaptive
theming, the web OpenUI kit).
FRONT
)
  fi
  cat <<PROMPT
You are the software engineer of an Aseman space. $task

$frontend

Context files here: AGENTS.md (your rules: follow them), ELPIAN.md (the Elpian
frontend guide and reference), BRIEF.md (+ CHANGES.md),
APPS.json (the space: apps with microtools and their args_schema, and agents),
ASEMAN_API.md (the exact page API contract), JOB.json (port $port, dir),
vendor/aseman-sdk/ (aseman.js for the page; server.cjs / server.mjs /
aseman_server.py for your server: use them for every Aseman call),
vendor/aseman-openui/ (agent-backed UI islands).

Work in this order:
1. Plan: list the screens, the data, and for each feature whether it is
   programmed (your server, or a microtool via Aseman.call) or needs an
   agent's judgment (Aseman.ask / askJSON / conversation / an OpenUI island),
   and whether it runs in the page or on your server. Server-side agent and
   app calls use the server SDK: Aseman.fromRequest(req) while serving a
   person (billed to them), Aseman.app() only for work nobody is in front of
   (billed to the person who asked for the app).
   Use only the apps, microtools, argument shapes and agents APPS.json lists.
   Write the plan to PLAN.md.
2. Build the fullstack project (frontend + backend) as described above.
3. Test: unit/API tests for your server, the theme applicator, parsing of
   microtool results (fixtures shaped like real replies) and the handling of
   agent replies (mock Aseman.ask and the server SDK). Run them until they
   pass. Never call the real Aseman API from tests.
4. Make sure the start command serves the built app in the foreground on
   0.0.0.0:$port (read PORT from the environment, default $port) without
   rebuilding, and that GET / answers.
5. Only then write READY.json as AGENTS.md specifies (with "ui": "$ui"$( [[ "$ui" == "elpian" ]] && printf '%s' ' and "elpian": "elpian/app.js"')).
Keep everything inside $dir. Do not ask questions: decide sensibly and note
assumptions in PLAN.md.
PROMPT
}

repair_prompt() {
  local port="$1" problem="$2"
  cat <<PROMPT
The app in this directory is not ready. The platform checked it and found:

$problem

Find the root cause and fix it (AGENTS.md, ELPIAN.md for an Elpian frontend,
BRIEF.md, CHANGES.md and PLAN.md describe the app). Run the tests again, make sure the start command serves on
0.0.0.0:$port and GET / answers, then rewrite READY.json.
PROMPT
}

cmd_build() {
  local dir="" brief="" apps="" title="App" port=8787 mode="new" ui="elpian"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --brief-file) brief="$2"; shift 2 ;;
      --apps-file) apps="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --ui) ui="$2"; shift 2 ;;
      *) die "unknown build flag $1" ;;
    esac
  done
  [[ -n "$dir" ]] || die "build needs --dir"
  [[ -n "$brief" && -f "$brief" ]] || die "build needs --brief-file"
  [[ "$mode" == "new" || "$mode" == "update" ]] || die "--mode is new or update"
  [[ "$ui" == "elpian" || "$ui" == "web" ]] || die "--ui is elpian or web"
  dir=$(mkdir -p "$dir" && cd "$dir" && pwd)
  cp -f "$ROOT/AGENTS.md" "$dir/AGENTS.md"
  if [[ -f "$ROOT/ASEMAN_API.md" ]]; then
    cp -f "$ROOT/ASEMAN_API.md" "$dir/ASEMAN_API.md"
  fi
  if [[ -d "$ROOT/openui" ]]; then
    mkdir -p "$dir/vendor/aseman-openui"
    cp -a "$ROOT/openui/." "$dir/vendor/aseman-openui/"
  fi
  if [[ -d "$ROOT/elpian" ]]; then
    mkdir -p "$dir/vendor/aseman-elpian"
    for f in aseman-elpian.js openui-elpian.js bundle.mjs check.mjs nodes.json ELPIAN.md; do
      [[ -f "$ROOT/elpian/$f" ]] && cp -f "$ROOT/elpian/$f" "$dir/vendor/aseman-elpian/$f"
    done
    [[ -f "$ROOT/elpian/ELPIAN.md" ]] && cp -f "$ROOT/elpian/ELPIAN.md" "$dir/ELPIAN.md"
  fi
  if [[ -d "$ROOT/sdk" ]]; then
    mkdir -p "$dir/vendor/aseman-sdk"
    for f in aseman.js server.cjs server.mjs aseman_server.py; do
      [[ -f "$ROOT/sdk/$f" ]] && cp -f "$ROOT/sdk/$f" "$dir/vendor/aseman-sdk/$f"
    done
  fi
  if [[ "$mode" == "update" ]]; then
    # Keep the history of what was asked: the original brief and each change.
    { echo; echo "## Change requested $(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo; cat "$brief"; } >>"$dir/CHANGES.md"
    [[ -f "$dir/BRIEF.md" ]] || cp -f "$brief" "$dir/BRIEF.md"
  elif ! same_file "$brief" "$dir/BRIEF.md"; then
    cp -f "$brief" "$dir/BRIEF.md"
  fi
  if [[ -n "$apps" && -f "$apps" ]]; then
    if ! same_file "$apps" "$dir/APPS.json"; then
      cp -f "$apps" "$dir/APPS.json"
    fi
  else
    echo '{"apps":[],"agents":[]}' >"$dir/APPS.json"
  fi
  write_file "$dir/JOB.json" <<EOF
{"title":$(jq -Rn --arg t "$title" '$t'),"port":$port,"dir":"$dir","mode":"$mode","ui":"$ui"}
EOF
  rm -f "$dir/READY.json"

  # OpenCode builds; the platform then checks the result itself (READY.json,
  # and that the app really starts and answers) and sends what it found back
  # to OpenCode for up to ASEMAN_APPUI_REPAIRS rounds.
  local rounds="${ASEMAN_APPUI_REPAIRS:-2}" round=0 problem=""
  if ! run_opencode "$dir" "$(build_prompt "$dir" "$port" "$mode" "$ui")"; then
    problem="the OpenCode session failed or timed out (see opencode.log); finish the work"
  fi
  while true; do
    if [[ -z "$problem" ]]; then
      problem=$(check_ready "$dir") || true
    fi
    if [[ -z "$problem" ]]; then
      problem=$(verify_app "$dir") || true
    fi
    if [[ -z "$problem" ]]; then
      echo "aseman-appui: verified: the app starts and answers on port $port"
      break
    fi
    if (( round >= rounds )); then
      echo "aseman-appui: not ready after $round repair round(s): $problem" >&2
      jq -n --arg e "$problem" '{ok:false, error:$e}' >"$dir/READY.json"
      cmd_status "$dir"
      return 1
    fi
    round=$((round + 1))
    echo "aseman-appui: repair round $round: $problem" | tee -a "$dir/opencode.log"
    rm -f "$dir/READY.json"
    run_opencode "$dir" "$(repair_prompt "$port" "$problem")" || true
    problem=""
  done
  cmd_status "$dir"
}

usage() {
  cat <<EOF
Usage: aseman-appui <command> [flags]

OpenCode uses Aseman's metered LLM gateway (ASEMAN_LLM_*), the same backbone
as space agents. Token usage is billed on the agent turn.

Commands:
  models                 Show backbone / model selection
  run --dir DIR --message TEXT
                         Distribute a coding task to OpenCode
  build --dir DIR --brief-file FILE [--apps-file FILE] [--title T] [--port N] [--mode new|update] [--ui elpian|web]
                         Full App UI build: OpenCode plans, builds and tests; the
                         platform then starts the app and checks that it answers,
                         with repair rounds (ASEMAN_APPUI_REPAIRS, default 2).
                         update changes an existing app in place (CHANGES.md).
                         --ui elpian (default: an Elpian program, ELPIAN.md) or web
                         (only when the person asked for web technology).
  status [--dir DIR]     Show STATUS.json / READY.json
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    models) cmd_models "$@" ;;
    run) cmd_run "$@" ;;
    build) cmd_build "$@" ;;
    status) cmd_status "${1:-.}" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command $cmd" ;;
  esac
}

main "$@"
