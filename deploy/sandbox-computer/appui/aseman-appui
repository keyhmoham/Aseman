#!/usr/bin/env bash
# Aseman App UI helper. The space's agents build apps: `prepare` lays out the
# project and their task, they build it with their own tools, and `verify`
# runs the platform's checks on it. READY.json follows passing tests.
set -euo pipefail

ROOT="${ASEMAN_APPUI_ROOT:-/opt/aseman-appui}"

die() { echo "aseman-appui: $*" >&2; exit 1; }



write_file() {
  local path="$1"
  local dir
  dir=$(dirname "$path")
  mkdir -p "$dir"
  cat >"$path"
}

same_file() {
  local a b
  a=$(readlink -f "$1" 2>/dev/null || echo "$1")
  b=$(readlink -f "$2" 2>/dev/null || echo "$2")
  [[ "$a" == "$b" ]]
}


cmd_status() {
  local dir="${1:-.}"
  dir=$(cd "$dir" && pwd)
  if [[ -f "$dir/READY.json" ]]; then
    echo "state: ready"
    cat "$dir/READY.json"
    return 0
  fi
  if [[ -f "$dir/STATUS.json" ]]; then
    echo "state: $(jq -r .state "$dir/STATUS.json" 2>/dev/null || echo running)"
    cat "$dir/STATUS.json"
    return 0
  fi
  echo "state: idle"
  echo '{"state":"idle"}'
}



# kit_file is a tool of the platform's checks: the platform's own copy (so a
# project's vendored copy, missing or edited, never decides whether it
# passes), else the project's.
kit_file() {
  if [[ -f "$ROOT/elpian/$1" ]]; then echo "$ROOT/elpian/$1"; else echo "$2/vendor/aseman-elpian/$1"; fi
}

# verify_app starts READY.json's `start` command the way the preview gateway
# will, waits for the port to answer and stops it again. Prints why it failed.
verify_app() {
  local dir="$1"
  local start port pid code
  start=$(jq -r '.start // empty' "$dir/READY.json" 2>/dev/null || true)
  port=$(jq -r '.port // empty' "$dir/READY.json" 2>/dev/null || true)
  if [[ -z "$start" || -z "$port" ]]; then
    echo "READY.json has no start command or port"
    return 1
  fi
  local ui entry elpian_problem=""
  ui=$(jq -r '.ui // "web"' "$dir/READY.json" 2>/dev/null || echo web)
  entry=$(jq -r '.elpian // "elpian/app.js"' "$dir/READY.json" 2>/dev/null || echo elpian/app.js)
  local widget
  widget=$(jq -r '.widget // "elpian/widget.js"' "$dir/READY.json" 2>/dev/null || echo elpian/widget.js)
  if [[ "$ui" == "elpian" ]]; then
    # The bundle is always rebuilt from elpian/src: what is checked and
    # served is the current frontend (its phone widget included).
    if ! out=$(node "$(kit_file bundle.mjs "$dir")" "$dir" 2>&1); then
      echo "the Elpian frontend could not be bundled: $out"
      return 1
    fi
  else
    # A web app's phone widget is an Elpian program of its own.
    if ! out=$(node "$(kit_file bundle.mjs "$dir")" "$dir" --widget 2>&1); then
      echo "the phone widget could not be bundled (write it in elpian/widget/, see ELPIAN.md): $out"
      return 1
    fi
  fi
  # A previous version may still serve the port: the new build is what is
  # checked and then served.
  fuser -k "$port/tcp" >/dev/null 2>&1 || true
  # Started as the preview will start it: from the project, with its server
  # settings (.aseman/server.env), PORT and HOST, under bash.
  (cd "$dir" && set -a && { [ ! -f .aseman/server.env ] || . .aseman/server.env; } && set +a && PORT="$port" HOST=0.0.0.0 exec setsid bash -c "$start") >"$dir/verify.log" 2>&1 &
  pid=$!
  code=000
  for _ in $(seq 1 "${ASEMAN_APPUI_VERIFY_SECS:-60}"); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:$port/" 2>/dev/null || true)
    [[ -n "$code" && "$code" != "000" ]] && break
    code=000
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if [[ "$code" != "000" ]] && (( code < 500 )); then
    if [[ "$ui" == "elpian" ]]; then
      elpian_problem=$(check_elpian "$dir" "$port" "$entry" "") || true
    else
      elpian_problem=$(check_elpian "$dir" "$port" "$widget" "--widget-only") || true
    fi
  fi
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fuser -k "$port/tcp" >/dev/null 2>&1 || true
  wait "$pid" 2>/dev/null || true
  if [[ "$code" == "000" ]]; then
    echo "\`$start\` did not answer on 0.0.0.0:$port. Its output:"
    tail -n 40 "$dir/verify.log" 2>/dev/null
    return 1
  fi
  if (( code >= 500 )); then
    echo "GET / on port $port answered HTTP $code. Server output:"
    tail -n 40 "$dir/verify.log" 2>/dev/null
    return 1
  fi
  if [[ -n "$elpian_problem" ]]; then
    echo "$elpian_problem"
    return 1
  fi
  return 0
}

# check_elpian checks an Elpian frontend against the running server: the
# server serves the bundle, the program runs on QuickJS (check.mjs), and
# (for the app itself) the end-to-end scenarios the builder wrote while driving
# it headlessly replay (drive.mjs run elpian/e2e).
check_elpian() {
  local dir="$1" port="$2" entry="$3" mode="$4" code out
  code=$(curl -s -o "$dir/.elpian-served.js" -w '%{http_code}' --max-time 5 "http://127.0.0.1:$port/$entry" 2>/dev/null || echo 000)
  if [[ "$code" != "200" ]]; then
    echo "GET /$entry answered HTTP $code: the server must serve the Elpian bundle at that path (ELPIAN.md)."
    return 1
  fi
  if ! cmp -s "$dir/.elpian-served.js" "$dir/$entry"; then
    echo "GET /$entry does not serve the current bundle $entry (it must serve the file itself, read on each request)."
    return 1
  fi
  rm -f "$dir/.elpian-served.js"
  if ! out=$(node "$(kit_file check.mjs "$dir")" "$dir/$entry" --apps "$dir/APPS.json" --server "http://127.0.0.1:$port" $mode 2>&1); then
    echo "The Elpian program $entry fails on QuickJS (vendor/aseman-elpian/check.mjs):"
    echo "$out" | tail -n 40
    return 1
  fi
  if [[ -z "$mode" && "${ASEMAN_APPUI_E2E:-1}" != "0" ]]; then
    if ! compgen -G "$dir/elpian/e2e/*.json" >/dev/null; then
      echo "The app has no end-to-end scenarios: drive it headlessly with the elpian_* driver tools (elpian_open, then elpian_tap / elpian_type / elpian_select … and elpian_expect) through every screen and control, and save each journey with elpian_save_scenario to elpian/e2e/*.json (ELPIAN.md, Testing end to end)."
      return 1
    fi
    if ! out=$(node "$(kit_file drive.mjs "$dir")" run "$dir/elpian/e2e" --dir "$dir" --bundle "$entry" --apps "$dir/APPS.json" --server "http://127.0.0.1:$port" 2>&1); then
      echo "The app's end-to-end scenarios fail (node vendor/aseman-elpian/drive.mjs run elpian/e2e): fix the app (or a scenario that expects the wrong thing):"
      echo "$out" | tail -n 80
      return 1
    fi
  fi
  return 0
}

# check_wiring prints why the app is not wired to its space for real: an
# agent or app it uses that APPS.json does not list, or a stand-in for the
# gateway's Aseman API (nothing when it is wired for real; warnings go to
# WIRING.md for the builder).
check_wiring() {
  local dir="$1" checker out
  checker="$ROOT/wiring-check.mjs"
  [[ -f "$checker" ]] || return 0
  if out=$(node "$checker" "$dir" 2>&1); then
    printf '%s\n' "$out" >"$dir/WIRING.md"
    return 0
  fi
  printf '%s\n' "$out" >"$dir/WIRING.md"
  echo "The app is not wired to this space for real (aseman-wiring-check, APPS.json):"
  echo "$out" | grep '^PROBLEM' | head -n 40
  echo "Use only the agents and apps APPS.json lists, by those names, through the Aseman API (vendor/aseman-sdk); never imitate one."
  return 1
}

# check_ready prints why READY.json is not acceptable (nothing when it is).
check_ready() {
  local dir="$1"
  if [[ ! -f "$dir/READY.json" ]]; then
    echo "READY.json was not written (tests not run, or failing?)"
    return 1
  fi
  if jq -e '.ok == false' "$dir/READY.json" >/dev/null 2>&1; then
    echo "READY.json reports a failure: $(jq -r '.error // "unknown"' "$dir/READY.json")"
    return 1
  fi
  if ! jq -e '.ok == true and .tested == true and (.start|type=="string" and length>0) and (.port|type=="number")' \
    "$dir/READY.json" >/dev/null 2>&1; then
    echo "READY.json is incomplete (needs ok, tested, start, port)"
    return 1
  fi
  local want
  # The frontend the app was asked for (JOB.json), else the one it reports.
  want=$(jq -r '.ui // empty' "$dir/JOB.json" 2>/dev/null || true)
  [[ -n "$want" ]] || want=$(jq -r '.ui // "elpian"' "$dir/READY.json" 2>/dev/null || echo elpian)
  if [[ "$want" == "elpian" ]] && ! jq -e '.ui == "elpian" and (.elpian|type=="string" and length>0)' "$dir/READY.json" >/dev/null 2>&1; then
    echo "this app's frontend is Elpian (JOB.json ui): READY.json needs \"ui\": \"elpian\" and \"elpian\": \"elpian/app.js\" (see ELPIAN.md)"
    return 1
  fi
  if [[ "$want" == "web" ]] && ! jq -e '(.widget|type=="string" and length>0)' "$dir/READY.json" >/dev/null 2>&1; then
    echo "every app has a phone widget: READY.json needs \"widget\": \"elpian/widget.js\" (an Elpian program in elpian/widget/, see ELPIAN.md, A web app's widget)"
    return 1
  fi
}

build_prompt() {
  local dir="$1" port="$2" mode="$3" ui="${4:-elpian}" engine="${5:-agents}" kind="${6:-app}" audience="${7:-space}" task frontend host="" tools="" finish="" people=""
  if [[ "$mode" == "update" ]]; then
    task="This is an existing app (BRIEF.md is what it was built for). Make the change requested last in CHANGES.md and keep everything else working. Read the project before editing; change only what the request needs. With an Elpian frontend, replay the existing end-to-end scenarios (elpian/e2e) first, then drive the changed and new parts headlessly step by step, and update or add scenarios so they cover them."
  else
    task="Build a new app for BRIEF.md in this directory."
  fi
  if [[ "$ui" == "elpian" ]]; then
    frontend=$(cat <<FRONT
The frontend is an ELPIAN program (JOB.json ui: elpian), not a web page:
JavaScript on the Elpian QuickJS runtime inside the Aseman client, drawing
native UI from JSON view trees. Read ELPIAN.md in full first and study
vendor/aseman-elpian/ (aseman-elpian.js SDK, openui-elpian.js, nodes.json).
Write it in elpian/src/*.js with App.create + Aseman.* (no DOM, no fetch, no
modules); use the UI kit nodes for data views and app pieces — charts
(Chart, Funnel, Waterfall, Sankey, Gantt, BoxPlot, Sunburst,
CalendarHeatmap, …), tables (DataGrid, PivotTable, Leaderboard) and widgets
(Tabs, Calendar, Kanban, Chat, Carousel, Stepper, Markdown, Countdown,
QRCode, EmptyState, …) rather than hand-building them from boxes; mix OpenUI agent islands
(OpenUI.panel / action / query) with programmed UI where judgment helps.
Design it in Material 3 Expressive, following ELPIAN.md's "Design" section:
study vendor/aseman-elpian/examples/showcase.js (a complete reference app)
first. Every screen gets a clear hierarchy (an emphasized headline, one
primary action, the key fact made big on a tonal or accent card), Text
type roles (variant) instead of ad-hoc font sizes, tonal surfaces
(Card variant/tone, ListGroup + ListTile) instead of borders, Material icon
names (never emoji or glyphs), M3E controls (Button variants and sizes,
IconButton, SegmentedButton, Chip, SearchBar, NavigationBar, FAB), motion
for state changes, and designed loading, empty and error states. Make it
look like a polished, modern product someone would want to use daily — give
it one distinctive idea of its own (a hero visual, a playful detail, a
clever layout), not a generic form-and-table page.
Give App.create its phone widget (ELPIAN.md, The phone widget): a glanceable,
live view of the few facts that matter for this app's use case, refreshed on
a timer, designed for small, medium and large tiles.
Validate every view tree you write with the Elpian UI DSL validator — your
elpian_* tools (an MCP server), or the same thing on the command line:
  elpian_describe / node vendor/aseman-elpian/validate.mjs --describe Button,ListTile
    before using a node: its props, events, children, parents, layout needs;
  elpian_icons / grep icons.json to pick icon names;
  elpian_validate / node vendor/aseman-elpian/validate.mjs tree.json
    on any tree or component you are unsure of (props, styles, events, keys,
    parent-child relations, layout constraints, widget rules, design);
  elpian_validate_program / node vendor/aseman-elpian/validate.mjs --program elpian/app.js --server http://127.0.0.1:$port
    on the bundle, which runs it, taps its handlers and validates every
    render as the app and as the phone widget.
Fix every error (each is a crash, a blank or a wrong render on people's
phones) and the warnings; act on the design notes.
Then prove the app works END TO END by using it headlessly, as a person would,
with the Elpian driver — your elpian_open / elpian_snapshot / elpian_tap /
elpian_type / elpian_select / elpian_toggle / elpian_gesture / elpian_wait /
elpian_expect / elpian_mock / elpian_coverage tools (ELPIAN.md, Testing end to
end). With your server running, open a session, read the screen outline, and
go section by section through EVERY screen and EVERY control: use it, check
with elpian_expect what a person should then see (and the state and the
request it made), with realistic mocks for the space's agents and apps (also
their failures, and held requests for loading states), on a phone and a desk
window. Every PROBLEM a step reports is a bug: fix it, rebuild, elpian_reload,
go on. Keep going until elpian_coverage lists no unused control. Save each
user journey with elpian_save_scenario (one session per journey) to
elpian/e2e/*.json and run them all with elpian_run_scenarios (or
node vendor/aseman-elpian/drive.mjs run elpian/e2e --server http://127.0.0.1:$port):
the platform replays them against your server before the app is ready, so
they must pass, and must not depend on data a previous run left behind.
Your server serves GET /elpian/app.js (the bundle) and its API. Bundle with
node vendor/aseman-elpian/bundle.mjs . and check with
node vendor/aseman-elpian/check.mjs elpian/app.js --apps APPS.json --server http://127.0.0.1:$port
(with the server running) until it passes (it includes the validator). AGENTS.md's web-only rules
(@material/web, web theming, the web OpenUI kit) do not apply; its design
bar does, met with Elpian nodes.
FRONT
)
  else
    frontend=$(cat <<FRONT
The frontend is WEB (JOB.json ui: web), because the person asked for web
technology: follow AGENTS.md's web rules (Material 3 Expressive via
@material/web unless the brief names another framework, Aseman adaptive
theming, the web OpenUI kit).
Every app also has a phone widget, and it is native: write it as an Elpian
program in elpian/widget/*.js (ELPIAN.md: The phone widget, and A web app's
widget) showing the few live facts that matter for this app's use case.
Your server serves GET /elpian/widget.js; bundle it with
node vendor/aseman-elpian/bundle.mjs . --widget and check it with
node vendor/aseman-elpian/check.mjs elpian/widget.js --widget-only --apps APPS.json --server http://127.0.0.1:$port
(validate its trees with your elpian_validate_program tool, widgetOnly: true,
or node vendor/aseman-elpian/validate.mjs --program elpian/widget.js --widget-only).
FRONT
)
  fi
  if [[ "$kind" == "gadget" ]]; then
    host=$(cat <<HOST

## Hosting: gadget mode (JOB.json kind: gadget)
Read GADGETS.md. This App UI is a **compact frameless widget**, not a desk
window:
- No window frame, title bar or background pad — any custom shape.
- Very compact like a mobile home-screen widget: only the necessary live facts
  and controls; dense, glanceable; do not take much screen space; no multi-pane
  app chrome or full-window layouts.
- People float it over chat / rail / desk or open it as a page.
Design every screen for a small footprint first. The phone widget still applies.
HOST
)
  else
    host=$(cat <<HOST

## Hosting: window mode (JOB.json kind: app)
This App UI opens as a **framed desk card window** (title bar, resize, pin).
Design for a desk window and for phones; include the phone widget.
HOST
)
  fi
  if [[ "$audience" == "platform" ]]; then
    people=$(cat <<PEOPLE

## Audience: a platform's frontend (JOB.json audience: platform)
Read PLATFORM.md first. This app will be the frontend of a platform the
person runs: its people are that platform's, not members of this space, and
some arrive signed out. It is still wired to THIS space's agents and apps
(APPS.json): they are the platform's backend services in the loop.
- Signed-out visitors (no X-Aseman-User-Token on the request, no person in
  Aseman.context()): serve them what needs no agent or app, and a clear way to
  sign in; never call the Aseman API for them.
- Signed-in people: the page's Aseman calls and your server's calls with the
  request's token (Aseman.fromRequest(req)) reach the wired agents and apps,
  run as (and billed to) the person who publishes the frontend, and name the
  platform's person on the usage record. Key your own data by the person's
  id (X-Aseman-User) and keep each person's data their own.
- Only the agents and apps in APPS.json answer for a platform; anything else
  is refused.
PEOPLE
)
  fi
  if [[ "$engine" == "agents" ]]; then
    tools=$(cat <<TOOLS

You are building this yourself, with your own tools on the space's sandbox:
the shell (execute) and the file tools, in $dir. Your elpian_* tools (the
validator and the headless driver named above) are the aseman-elpian command,
with the same names and JSON arguments, run in $dir:
  aseman-elpian tools [name]       the tools and their arguments
  aseman-elpian elpian_open '{"server":"http://127.0.0.1:$port"}'
  aseman-elpian elpian_tap '{"target":"Add task"}'   (sessions stay open between commands)
  aseman-elpian elpian_validate @tree.json            (arguments from a file)
  aseman-elpian stop                                  (end the driver sessions)
While you test, run your server in the background
(cd $dir && nohup <start command> > server.log 2>&1 &) and stop it when done.
TOOLS
)
    finish=$(cat <<FINISH

6. Call appui_publish with dir $dir. The platform verifies the app itself
   (READY.json, the start command answering on the port$( [[ "$ui" == "elpian" ]] && printf '%s' ', the bundle, the
   program on QuickJS against your server, your end-to-end scenarios') and
   $( [[ "$kind" == "gadget" ]] && printf '%s' 'registers it as a compact frameless gadget' || printf '%s' 'opens it as a framed desk window'). If it reports a problem, find the root cause, fix it,
   run your tests again, rewrite READY.json and call appui_publish again
   (REPAIR.md holds the last problem) until it opens.
FINISH
)
  fi
  cat <<PROMPT
You are the software engineer of an Aseman space. $task
$host$people
$frontend
$tools

Context files here: AGENTS.md (your rules: follow them), ELPIAN.md (the Elpian
frontend guide and reference)$( [[ "$kind" == "gadget" ]] && printf '%s' ', GADGETS.md (gadget mode: compact widget rules)'), BRIEF.md (+ CHANGES.md),
APPS.json (the space: apps with microtools and their args_schema, and agents —
the only ones the app may use, by those names),$( [[ "$audience" == "platform" ]] && printf '\n%s' 'PLATFORM.md (building a platform'"'"'s frontend),')
ASEMAN_API.md (the exact page API contract), JOB.json (port $port, dir),
vendor/aseman-sdk/ (aseman.js for the page; server.cjs / server.mjs /
aseman_server.py for your server: use them for every Aseman call),
vendor/aseman-openui/ (agent-backed UI islands).

Work in this order:
1. Plan: list the screens, the data, and for each feature whether it is
   programmed (your server, or a microtool via Aseman.call) or needs an
   agent's judgment (Aseman.ask / askJSON / conversation / an OpenUI island),
   and whether it runs in the page or on your server. Server-side agent and
   app calls use the server SDK: Aseman.fromRequest(req) while serving a
   person (billed to them), Aseman.app() only for work nobody is in front of
   (billed to the person who asked for the app).
   Use only the apps, microtools, argument shapes and agents APPS.json lists,
   by those names, and use them for real: every feature the brief gives to
   an agent or an app calls that agent or app through the Aseman API — never
   a made-up agent or app, a hard-coded reply, a direct model call or a fake
   endpoint standing in for one (mocks belong in tests only). The platform
   checks the code against APPS.json (aseman-wiring-check) before the app is
   ready. If the brief needs an agent or app the space does not have, say so
   in PLAN.md and leave that feature out rather than imitating it.
   Decide what the phone widget shows: the live facts someone checks at a
   glance for this app. Decide the design: the hero of each screen, the
   layout on a phone and on a wide desk window, the components, the
   loading / empty / error states, and one distinctive touch. Write the plan
   to PLAN.md.
2. Build the fullstack project (frontend + backend) as described above.
3. Test: unit/API tests for your server, the theme applicator, parsing of
   microtool results (fixtures shaped like real replies) and the handling of
   agent replies (mock Aseman.ask and the server SDK). Run them until they
   pass. Never call the real Aseman API from tests.$( [[ "$ui" == "elpian" ]] && printf '\n%s' '   Then test the app end to end with the Elpian driver (above): every screen,
   every control, each journey saved to elpian/e2e and passing.')
4. Make sure the start command serves the built app in the foreground on
   0.0.0.0:$port (read PORT from the environment, default $port) without
   rebuilding, and that GET / answers.
5. Only then write READY.json as AGENTS.md specifies (with "ui": "$ui"$( [[ "$ui" == "elpian" ]] && printf '%s' ' and "elpian": "elpian/app.js"' || printf '%s' ' and "widget": "elpian/widget.js"')).$finish
Keep everything inside $dir. Do not ask questions: decide sensibly and note
assumptions in PLAN.md.
PROMPT
}

repair_prompt() {
  local port="$1" problem="$2" engine="${3:-agents}" after=""
  if [[ "$engine" == "agents" ]]; then
    after="
Your elpian_* tools are the aseman-elpian command (aseman-elpian tools lists
them). When it is fixed, call appui_publish with this dir again."
  fi
  cat <<PROMPT
The app in this directory is not ready. The platform checked it and found:

$problem

Find the root cause and fix it (AGENTS.md, ELPIAN.md for an Elpian frontend,
BRIEF.md, CHANGES.md and PLAN.md describe the app). For an Elpian frontend,
the elpian_validate_program tool (or node vendor/aseman-elpian/validate.mjs
--program elpian/app.js --server http://127.0.0.1:$port) shows each problem in
the view trees with where it is and how to fix it, and the Elpian driver
(elpian_open, elpian_tap, … elpian_run_scenarios; ELPIAN.md, Testing end to
end) reproduces a failing scenario step by step: replay it by hand, read the
screen and the PROBLEMS at the failing step, fix the app (or the scenario, if
it expects the wrong thing), and run every scenario again. Run the tests again, make sure the start command serves on
0.0.0.0:$port and GET / answers, then rewrite READY.json.$after
PROMPT
}

# parse_job reads the flags of build / prepare into the job_* variables.
parse_job() {
  job_dir="" job_brief="" job_apps="" job_title="App" job_port=8787 job_mode="new" job_ui="elpian" job_kind="app" job_audience="space"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) job_dir="$2"; shift 2 ;;
      --brief-file) job_brief="$2"; shift 2 ;;
      --apps-file) job_apps="$2"; shift 2 ;;
      --title) job_title="$2"; shift 2 ;;
      --port) job_port="$2"; shift 2 ;;
      --mode) job_mode="$2"; shift 2 ;;
      --ui) job_ui="$2"; shift 2 ;;
      --kind) job_kind="$2"; shift 2 ;;
      --audience) job_audience="$2"; shift 2 ;;
      *) die "unknown flag $1" ;;
    esac
  done
  [[ -n "$job_dir" ]] || die "needs --dir"
  [[ -n "$job_brief" && -f "$job_brief" ]] || die "needs --brief-file"
  [[ "$job_mode" == "new" || "$job_mode" == "update" ]] || die "--mode is new or update"
  [[ "$job_ui" == "elpian" || "$job_ui" == "web" ]] || die "--ui is elpian or web"
  [[ "$job_kind" == "app" || "$job_kind" == "gadget" || "$job_kind" == "plugin" ]] || die "--kind is app or gadget"
  [[ "$job_kind" == "plugin" ]] && job_kind="gadget"
  [[ "$job_audience" == "space" || "$job_audience" == "platform" ]] || die "--audience is space or platform"
  job_dir=$(mkdir -p "$job_dir" && cd "$job_dir" && pwd)
}

# prepare_project lays out the project for the agents that build it:
# the guides, the SDKs and the Elpian toolchain, BRIEF.md (+ CHANGES.md for
# an update), APPS.json and JOB.json.
prepare_project() {
  local engine="$1" dir="$job_dir" brief="$job_brief" apps="$job_apps"
  cp -f "$ROOT/AGENTS.md" "$dir/AGENTS.md"
  if [[ -f "$ROOT/ASEMAN_API.md" ]]; then
    cp -f "$ROOT/ASEMAN_API.md" "$dir/ASEMAN_API.md"
  fi
  if [[ -d "$ROOT/openui" ]]; then
    mkdir -p "$dir/vendor/aseman-openui"
    cp -a "$ROOT/openui/." "$dir/vendor/aseman-openui/"
  fi
  if [[ -d "$ROOT/elpian" ]]; then
    mkdir -p "$dir/vendor/aseman-elpian"
    for f in aseman-elpian.js openui-elpian.js bundle.mjs check.mjs nodes.json ELPIAN.md validate.mjs validate-mcp.mjs schema.mjs icons.json drive.mjs drive-mcp.mjs mcp-stdio.mjs elpian-cli.mjs; do
      [[ -f "$ROOT/elpian/$f" ]] && cp -f "$ROOT/elpian/$f" "$dir/vendor/aseman-elpian/$f"
    done
    [[ -f "$ROOT/elpian/ELPIAN.md" ]] && cp -f "$ROOT/elpian/ELPIAN.md" "$dir/ELPIAN.md"
    [[ -f "$ROOT/elpian/GADGETS.md" ]] && cp -f "$ROOT/elpian/GADGETS.md" "$dir/GADGETS.md"
    if [[ "$job_audience" == "platform" && -f "$ROOT/PLATFORM.md" ]]; then
      cp -f "$ROOT/PLATFORM.md" "$dir/PLATFORM.md"
    fi
    # The developer API guide, for a server given app_developer_access.
    [[ -f "$ROOT/DEVELOPER.md" ]] && cp -f "$ROOT/DEVELOPER.md" "$dir/DEVELOPER.md"
    if [[ -d "$ROOT/elpian/examples" ]]; then
      mkdir -p "$dir/vendor/aseman-elpian/examples"
      cp -a "$ROOT/elpian/examples/." "$dir/vendor/aseman-elpian/examples/"
    fi
  fi
  if [[ -d "$ROOT/sdk" ]]; then
    mkdir -p "$dir/vendor/aseman-sdk"
    for f in aseman.js server.cjs server.mjs aseman_server.py; do
      [[ -f "$ROOT/sdk/$f" ]] && cp -f "$ROOT/sdk/$f" "$dir/vendor/aseman-sdk/$f"
    done
  fi
  if [[ "$job_mode" == "update" ]]; then
    # Keep the history of what was asked: the original brief and each change.
    { echo; echo "## Change requested $(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo; cat "$brief"; } >>"$dir/CHANGES.md"
    [[ -f "$dir/BRIEF.md" ]] || cp -f "$brief" "$dir/BRIEF.md"
  elif ! same_file "$brief" "$dir/BRIEF.md"; then
    cp -f "$brief" "$dir/BRIEF.md"
  fi
  if [[ -n "$apps" && -f "$apps" ]]; then
    if ! same_file "$apps" "$dir/APPS.json"; then
      cp -f "$apps" "$dir/APPS.json"
    fi
  else
    echo '{"apps":[],"agents":[]}' >"$dir/APPS.json"
  fi
  jq -n --arg t "$job_title" --argjson p "$job_port" --arg d "$dir" --arg m "$job_mode" --arg u "$job_ui" --arg k "$job_kind" --arg e "$engine" --arg a "$job_audience" \
    '{title:$t, port:$p, dir:$d, mode:$m, ui:$u, kind:$k, engine:$e, audience:$a}' >"$dir/JOB.json"
  rm -f "$dir/READY.json" "$dir/REPAIR.md"
}

# check_app prints why the app is not ready (nothing when it is): what
# READY.json says, then the app itself, started and checked the way the
# gateway and the client will use it.
check_app() {
  local dir="$1" problem
  problem=$(check_ready "$dir") || true
  if [[ -z "$problem" ]]; then
    problem=$(check_wiring "$dir") || true
  fi
  if [[ -z "$problem" ]]; then
    problem=$(verify_app "$dir") || true
  fi
  if [[ -n "$problem" ]]; then
    echo "$problem"
    return 1
  fi
}


# cmd_prepare lays out a project for the space's agents to build and prints
# their task (TASK.md): plan, build, test and drive it end to end with their
# own tools.
cmd_prepare() {
  parse_job "$@"
  local dir="$job_dir"
  prepare_project agents
  build_prompt "$dir" "$job_port" "$job_mode" "$job_ui" agents "$job_kind" "$job_audience" >"$dir/TASK.md"
  jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{state:"building", engine:"agents", started_at:$at}' >"$dir/STATUS.json"
  cat "$dir/TASK.md"
}

# cmd_verify runs the platform's checks on an app the agents built: ready, or
# the problem and how to repair it (also in REPAIR.md) with exit 1.
cmd_verify() {
  local dir="."
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      -*) die "unknown flag $1" ;;
      *) dir="$1"; shift ;;
    esac
  done
  [[ -d "$dir" ]] || die "no project at $dir"
  dir=$(cd "$dir" && pwd)
  local port problem
  port=$(jq -r '.port // empty' "$dir/READY.json" 2>/dev/null || true)
  [[ -n "$port" ]] || port=$(jq -r '.port // 8787' "$dir/JOB.json" 2>/dev/null || echo 8787)
  if problem=$(check_app "$dir"); then
    rm -f "$dir/REPAIR.md"
    jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{state:"completed", engine:"agents", finished_at:$at}' >"$dir/STATUS.json"
    echo "aseman-appui: verified: the app starts and answers on port $port"
    cmd_status "$dir"
    return 0
  fi
  repair_prompt "$port" "$problem" agents >"$dir/REPAIR.md"
  jq -n --arg e "$problem" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{state:"needs_repair", engine:"agents", problem:$e, checked_at:$at}' >"$dir/STATUS.json"
  echo "aseman-appui: not ready" >&2
  cat "$dir/REPAIR.md"
  return 1
}

usage() {
  cat <<EOF
Usage: aseman-appui <command> [flags]

Apps are built by the space's agents: prepare lays the project out and prints
their task, they build it, and verify runs the platform's checks.

Commands:
  prepare --dir DIR --brief-file FILE [--apps-file FILE] [--title T] [--port N] [--mode new|update] [--ui elpian|web] [--kind app|gadget] [--audience space|platform]
                         Lay out the project for an agent to build and print its
                         task (TASK.md). update changes an existing app in place
                         (CHANGES.md). --ui elpian (default: an Elpian program,
                         ELPIAN.md) or web (only when the person asked for web
                         technology). --kind app (default: framed desk window)
                         or gadget (compact frameless widget; see GADGETS.md).
                         --audience space (default) or platform (the frontend
                         of a platform; see PLATFORM.md).
  verify [--dir] DIR     The platform's checks of a built app (READY.json, its
                         wiring to the space (APPS.json), start
                         and answer, Elpian bundle, QuickJS, end-to-end
                         scenarios); exit 1 with the problem (REPAIR.md).
  status [--dir DIR]     Show STATUS.json / READY.json
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    prepare) cmd_prepare "$@" ;;
    verify) cmd_verify "$@" ;;
    status) cmd_status "${1:-.}" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command $cmd" ;;
  esac
}

main "$@"
