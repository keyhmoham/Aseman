{
  "$schema": "https://opencode.ai/config.json",
  "model": "aseman/default",
  "provider": {
    "aseman": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Aseman",
      "options": {
        "baseURL": "{env:ASEMAN_LLM_BASE_URL}",
        "apiKey": "{env:ASEMAN_LLM_API_KEY}"
      },
      "models": {
        "default": {
          "name": "Aseman agent model"
        }
      }
    }
  },
  "permission": {
    "*": "allow"
  },
  "mcp": {
    "elpian": {
      "type": "local",
      "command": [
        "node",
        "/opt/aseman-appui/elpian/validate-mcp.mjs"
      ],
      "enabled": true
    }
  }
}
