{
  "name": "garage to a new room, chat, play the room's game and see the result",
  "viewport": "phone",
  "steps": [
    { "expect": { "text": "trophies on the shelf" } },
    { "do": "select", "target": { "key": "garage_theme" }, "value": "lab" },
    { "expect": { "text": "Research Lab", "request": { "method": "PUT", "path": "api/garage" } } },
    { "do": "select", "target": { "key": "garage_theme" }, "value": "garage" },
    { "expect": { "text": "Workshop Garage" } },
    { "do": "tap", "target": { "key": "garage_rooms" } },
    { "expect": { "text": "Host a game in a 3D room, or join one" } },
    { "do": "tap", "target": { "key": "rooms_new" } },
    { "expect": { "text": "Open a room" } },
    { "do": "type", "target": { "key": "newroom_name" }, "text": "Scenario chess club" },
    { "do": "tap", "target": { "key": "newroom_theme_lounge" } },
    { "do": "tap", "target": { "key": "newroom_create" } },
    { "expect": { "text": "Scenario chess club", "request": { "method": "POST", "path": "api/rooms" } } },
    { "do": "type", "target": { "key": "room_text" }, "text": "Good luck everyone" },
    { "do": "tap", "target": { "key": "room_send" } },
    { "expect": { "text": "Good luck everyone" } },
    { "do": "tap", "target": { "key": "room_play" } },
    { "expect": { "request": { "method": "POST" } } },
    { "do": "fire", "target": { "key": "game" }, "event": "assetprogress", "data": { "id": "game", "loaded": 40, "total": 100 } },
    { "expect": { "text": "Downloading Arena Chess…" } },
    { "do": "fire", "target": { "key": "game" }, "event": "assetload", "data": { "id": "game", "kind": "pack" } },
    { "do": "fire", "target": { "key": "game" }, "event": "gameevent", "data": { "id": "game", "type": "result", "game": "arena-chess", "outcome": "loss", "result": "0-1", "reason": "resignation", "score": 10, "moves": 12, "duration_s": 1, "level": 3 } },
    { "expect": { "text": "Defeat" } },
    { "expect": { "text": "Rating" } },
    { "do": "tap", "target": { "key": "play_done" } },
    { "expect": { "text": "Scenario chess club" } },
    { "expect": { "text": "lost Arena Chess vs level 3" } },
    { "do": "select", "target": { "key": "room_tabs" }, "value": "Board" },
    { "expect": { "text": "1 games" } },
    { "do": "select", "target": { "key": "room_tabs" }, "value": "Players" },
    { "expect": { "text": "host" } },
    { "do": "tap", "target": { "key": "room_close" } },
    { "expect": { "text": "Host a game in a 3D room, or join one" } }
  ]
}
