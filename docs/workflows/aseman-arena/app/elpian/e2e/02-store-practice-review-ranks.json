{
  "name": "store page, a practice match, a review, the leaderboards and editing the profile",
  "viewport": "phone",
  "steps": [
    { "do": "select", "target": { "key": "nav" }, "value": "Store" },
    { "expect": { "text": "Games for the Arena, each against AI opponents" } },
    { "do": "type", "target": { "key": "store_q" }, "text": "strike" },
    { "expect": { "text": "City Strike", "noText": "Classical chess on a marble board" } },
    { "do": "type", "target": { "key": "store_q" }, "text": "", "clear": true },
    { "do": "tap", "target": { "key": "store_card_city_strike" } },
    { "expect": { "text": "How it plays", "request": { "method": "GET", "path": "api/store/city-strike" } } },
    { "do": "tap", "target": { "key": "game_practice" } },
    { "expect": { "text": "Practice · match" } },
    { "do": "fire", "target": { "key": "game" }, "event": "gameevent", "data": { "id": "game", "type": "started", "game": "city-strike" } },
    { "do": "fire", "target": { "key": "game" }, "event": "gameevent", "data": { "id": "game", "type": "result", "game": "city-strike", "outcome": "loss", "reason": "killed in action", "score": 450, "kills": 3, "headshots": 1, "accuracy": 0.31, "waves_cleared": 0, "waves": 3, "duration_s": 1, "difficulty": 3 } },
    { "expect": { "text": "Defeat" } },
    { "do": "tap", "target": { "key": "play_done" } },
    { "do": "tap", "target": { "key": "game_back" } },
    { "do": "tap", "target": { "key": "store_card_city_strike" } },
    { "do": "type", "target": { "key": "review_text" }, "text": "The AI flanks like real players" },
    { "do": "tap", "target": { "key": "review_send" } },
    { "expect": { "text": "The AI flanks like real players", "request": { "method": "GET", "path": "api/store/city-strike" } } },
    { "do": "tap", "target": { "key": "game_back" } },
    { "do": "select", "target": { "key": "nav" }, "value": "Ranks" },
    { "expect": { "text": "The best of the Arena" } },
    { "do": "select", "target": { "key": "board_game" }, "value": "City Strike" },
    { "expect": { "text": "You are #" } },
    { "do": "select", "target": { "key": "board_period" }, "value": "This week" },
    { "expect": { "request": { "method": "GET", "path": "api/leaderboard" } } },
    { "do": "tap", "target": { "key": "top_me" } },
    { "expect": { "text": "Trophies" } },
    { "do": "tap", "target": { "key": "profile_edit" } },
    { "do": "type", "target": { "key": "pe_name" }, "text": "Scenario Player", "clear": true },
    { "do": "type", "target": { "key": "pe_title" }, "text": "Tactician", "clear": true },
    { "do": "tap", "target": { "key": "pe_color_ff9a5c" } },
    { "do": "tap", "target": { "key": "pe_save" } },
    { "expect": { "text": "Scenario Player", "request": { "method": "PATCH", "path": "api/me" } } }
  ]
}
