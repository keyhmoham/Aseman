        {"source": "kenney-fps", "file": "blaster.glb", "as": "blaster.glb"},
        {"source": "kenney-fps", "file": "blaster-repeater.glb", "as": "blaster-repeater.glb"},
        {"source": "kenney-city", "file": "building-small-a.glb", "as": "building-small-a.glb"},
        {"source": "kenney-city", "file": "building-small-b.glb", "as": "building-small-b.glb"},
