{
  "about": "The 3D models Aseman Arena uses, where they come from and under what licence. fetch_assets.py downloads them at build time (they are not checked in). Every source is CC0 (public domain): Poly Haven's models, Kenney's models in his starter kits, Quaternius' RobotExpressive.",
  "sources": {
    "polyhaven": {"name": "Poly Haven", "url": "https://polyhaven.com/models", "license": "CC0 1.0", "api": "https://api.polyhaven.com/files/{id}"},
    "kenney-city": {"name": "Kenney — Starter Kit City Builder", "url": "https://github.com/KenneyNL/Starter-Kit-City-Builder", "license": "CC0 1.0 (models), MIT (code)", "extra": ["Textures/colormap.png"], "base": "https://raw.githubusercontent.com/KenneyNL/Starter-Kit-City-Builder/4535092b740b378b700efd9df9e27a631815b84a/models/"},
    "kenney-racing": {"name": "Kenney — Starter Kit Racing", "url": "https://github.com/KenneyNL/Starter-Kit-Racing", "license": "CC0 1.0 (models), MIT (code)", "extra": ["Textures/colormap.png"], "base": "https://raw.githubusercontent.com/KenneyNL/Starter-Kit-Racing/2f2e5f2646dda89cb21d4e8539bab60c6e955dc8/models/"},
    "kenney-fps": {"name": "Kenney — Starter Kit FPS", "url": "https://github.com/KenneyNL/Starter-Kit-FPS", "license": "CC0 1.0 (models), MIT (code)", "extra": ["Textures/colormap.png"], "base": "https://raw.githubusercontent.com/KenneyNL/Starter-Kit-FPS/185fd2326d74a5cf858cffc616f87cf9696f9cc0/models/"},
    "quaternius": {"name": "Quaternius (Tomás Laulhé) — RobotExpressive, via three.js", "url": "https://github.com/mrdoob/three.js/tree/r170/examples/models/gltf/RobotExpressive", "license": "CC0 1.0", "base": "https://raw.githubusercontent.com/mrdoob/three.js/r170/examples/models/gltf/RobotExpressive/"}
  },
  "targets": {
    "chess": {
      "dest": "chess/arena/chess/models",
      "items": [
        {"source": "polyhaven", "id": "chess_set", "as": "chess_set", "format": "gltf"}
      ]
    },
    "city-strike": {
      "dest": "city-strike/arena/city_strike/models",
      "items": [
