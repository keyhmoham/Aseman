; Aseman Arena — City Strike. A Godot 4.3 project: played in the browser
; (Web export) and inside the Aseman client's Scene3D (this project's files
; exported as a resource pack, mounted under res://arena/city_strike/).

config_version=5

[application]

config/name="City Strike"
config/description="A third-person shooter in a city, against AI squads."
run/main_scene="res://arena/city_strike/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://arena/city_strike/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
