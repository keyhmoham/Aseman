{
 "name": "when the analyst fails, the chat says why and still shows the results",
 "viewport": "phone",
 "mocks": [
  {
   "path": "api/info",
   "json": {
    "platform": "Peyda",
    "signed_in": true,
    "services": 61,
    "sites": [
     "Digikala"
    ],
    "extractor": {
     "ready": true,
     "engine": "gliner2"
    },
    "max_rounds": 3
   }
  },
  {
   "path": "api/chats",
   "json": {
    "chats": []
   }
  },
  {
   "path": "api/chats",
   "json": {
    "id": "c1",
    "title": "New chat"
   }
  },
  {
   "path": "api/chats/*/messages",
   "status": 202,
   "json": {
    "run": "r1",
    "message": {
     "id": "u1",
     "role": "user",
     "text": "x"
    }
   }
  },
  {
   "path": "api/runs/*",
   "json": {
    "id": "r1",
    "chat": "c1",
    "status": "done",
    "error": "",
    "next": 4,
    "events": [
     {
      "i": 0,
      "type": "stage",
      "name": "extract",
      "round": 1,
      "query": "q"
     },
     {
      "i": 1,
      "type": "service",
      "round": 1,
      "id": "digikala",
      "title": "Digikala",
      "status": "ok",
      "count": 2,
      "ms": 400,
      "reason": ""
     },
     {
      "i": 2,
      "type": "stage",
      "name": "answer",
      "round": 2
     },
     {
      "i": 3,
      "type": "done"
     }
    ],
    "message": {
     "id": "a1",
     "role": "assistant",
     "text": "Results for «cheap samsung phone» (the analyst was unavailable, so these are unreviewed)",
     "payload": {
      "cards": [
       {
        "service": "digikala",
        "tool": "t",
        "title": "Samsung Galaxy A55",
        "url": "https://example.com/x",
        "price_toman": 18500000,
        "detail": "Digikala seller",
        "ref": "digikala:0",
        "source": "Digikala"
       }
      ],
      "suggestions": [
       "Only Samsung",
       "Cheaper?"
      ],
      "rounds": [
       {
        "n": 1,
        "query": "cheap samsung",
        "total": 3,
        "score": 9,
        "verdict": "refine",
        "reason": "too broad"
       },
       {
        "n": 2,
        "query": "samsung galaxy under 20 million toman",
        "total": 3,
        "score": 11,
        "verdict": "satisfied",
        "reason": "good spread"
       }
      ],
      "degraded": true,
      "degraded_reason": "DecillionError: the platform answered 404: no agent named Peyda Analyst"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "do": "toggle",
   "target": {
    "key": "agentic"
   },
   "on": true
  },
  {
   "do": "type",
   "target": {
    "key": "q"
   },
   "text": "cheap samsung phone"
  },
  {
   "do": "tap",
   "target": {
    "type": "Button",
    "text": "Search"
   }
  },
  {
   "expect": {
    "text": [
     "The analyst was unavailable",
     "Why: DecillionError: the platform answered 404",
     "no agent named Peyda Analyst",
     "Samsung Galaxy A55"
    ]
   }
  }
 ]
}
