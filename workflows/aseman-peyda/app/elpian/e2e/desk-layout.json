     "Places",
     "Gold & currency"
    ]
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "Card",
    "text": "Shopping"
   }
  },
  {
   "expect": {
    "state": {
     "mode": "results",
     "q": "ارزان‌ترین گوشی سامسونگ زیر ۲۰ میلیون تومان"
    },
    "text": [
     "Sites",
     "All sites",
     "Sites answered",
     "Lowest price found"
    ],
    "request": {
     "method": "POST",
     "path": "api/search"
    }
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "ListTile",
    "text": "Google Maps"
   }
  },
  {
   "expect": {
    "state": {
     "filter": "gmaps"
    },
    "text": "Samsung Store Valiasr",
    "noText": "Samsung Galaxy S24"
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "ListTile",
    "text": "All sites"
   }
  },
  {
   "expect": {
    "state": {
     "filter": "all"
    },
    "text": "Samsung Galaxy S24"
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "InkWell",
    "text": "Peyda"
   }
  },
  {
   "expect": {
    "state": {
     "mode": "home"
    }
   }
  },
  {
   "do": "tap",
   "target": "Chat history"
  },
  {
   "do": "tap",
   "target": "cheap samsung phone"
  },
  {
   "expect": {
    "text": [
     "New chat",
     "Recent",
     "flights to Kish",
     "Samsung Galaxy A25",
     "Only 5G"
    ],
    "noText": "Show 1 earlier"
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "Card",
    "text": "Samsung Galaxy A25"
   }
  },
  {
   "expect": {
    "state": {
     "mode": "item",
     "back": "chat"
    },
    "text": "Open on Torob"
   }
  },
  {
   "do": "tap",
   "target": "Back to the chat"
  },
  {
   "expect": {
    "state": {
     "mode": "chat"
    }
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "ListTile",
    "text": "flights to Kish"
   }
  },
  {
   "expect": {
    "state": {
     "chat": "c2"
    }
   }
  },
  {
   "do": "tap",
   "target": {
    "type": "Button",
    "text": "New chat"
   }
  },
  {
   "expect": {
    "state": {
     "chat": null
    },
    "text": "Ask about anything in Iran"
   }
  }
 ]
