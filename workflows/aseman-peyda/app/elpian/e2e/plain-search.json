{
 "name": "a visitor searches and reads the results",
 "viewport": "phone",
 "mocks": [
  {
   "path": "api/info",
   "json": {
    "platform": "Peyda",
    "signed_in": true,
    "services": 61,
    "sites": [
     "Digikala"
    ],
    "extractor": {
     "ready": true,
     "engine": "gliner2"
    },
