      "missing": [],
      "hits": []
     }
    ]
   }
  }
 ],
 "steps": [
  {
   "expect": {
    "text": [
     "Peyda",
     "Agentic search"
    ],
    "noText": "Samsung Galaxy"
   }
  },
  {
   "do": "type",
   "target": {
    "key": "q"
   },
   "text": "گوشی سامسونگ زیر ۲۰ میلیون"
  },
  {
   "do": "tap",
   "target": {
    "type": "Button",
    "text": "Search"
   }
  },
  {
   "expect": {
    "text": [
     "Samsung Galaxy A55",
     "18,500,000 Toman",
     "Digikala",
     "Torob",
     "Understood as"
    ],
    "request": {
     "method": "POST",
     "path": "api/search"
    }
   }
  },
  {
   "do": "tap",
   "target": "Digikala 2"
  },
  {
   "expect": {
    "text": "Samsung Galaxy A35",
    "noText": "Samsung Galaxy A25"
   }
  },
  {
   "do": "tap",
   "target": "Torob 1"
  },
  {
   "expect": {
    "text": "Samsung Galaxy A25",
    "noText": "Samsung Galaxy A55"
   }
  },
  {
   "do": "tap",
   "target": "All"
  },
  {
   "expect": {
    "text": "Samsung Galaxy A55"
   }
  },
  {
   "do": "tap",
   "target": "1 service had nothing"
  },
  {
   "expect": {
    "text": "timed out"
   }
  },
  {
   "do": "tap",
   "target": "Back to search"
  },
  {
   "expect": {
    "text": "Search the Iranian web"
   }
  }
 ]
}
